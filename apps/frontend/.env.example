# Public values only (bundled into the browser).
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-ritme
VITE_FIREBASE_APP_ID=
# Use the Firebase Auth emulator (pnpm infra:auth at the repo root).
VITE_USE_AUTH_EMULATOR=true
VITE_AUTH_EMULATOR_URL=http://127.0.0.1:9099
# Run entirely against the in-browser fake API (no backend, no Firebase).
VITE_USE_MOCK_API=false
VITE_MOCK_LATENCY_MS=150
# Chrome extension id used by /connect when ?ext= is not given.
VITE_EXTENSION_ID=
