# Variable NAMES only. Copy to .env for local development. Never commit real values.
# No service-account JSON keys anywhere: GCP access is via Application Default Credentials.

# --- Runtime ---
ROLE=api                      # api | worker
ENVIRONMENT=local             # local | staging | production
LOG_LEVEL=info

# --- GCP / Vertex AI ---
GCP_PROJECT_ID=
GCP_REGION=asia-southeast2    # Cloud Run + Cloud SQL
VERTEX_LOCATION=us-central1   # where inference runs; verify model availability and document it
LLM_PROVIDER=fake             # fake | vertex   (fake needs no GCP; CI uses it)
LLM_MODEL_FAST=gemini-3.1-flash-lite
LLM_MODEL_PLAN=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=30000
AGENT_MAX_STEPS=8

# --- Database ---
DATABASE_URL=postgresql+psycopg://ritme:ritme_local_only@localhost:5433/ritme
# Cloud SQL (deployed): INSTANCE_CONNECTION_NAME, DB_NAME, DB_USER (password from Secret Manager)
INSTANCE_CONNECTION_NAME=
DB_NAME=
DB_USER=

# --- Auth (Firebase / Identity Platform) ---
FIREBASE_PROJECT_ID=demo-ritme
FIREBASE_AUTH_EMULATOR_HOST=127.0.0.1:9099   # local only; unset in production
EXTENSION_TOKEN_SECRET=                      # signs short-lived extension tokens (Secret Manager in prod)
EXTENSION_ACCESS_TTL_SECONDS=900

# --- Web / CORS ---
ALLOWED_ORIGINS=http://localhost:5173
EXTENSION_ID=
PUBLIC_WEB_URL=http://localhost:5173

# --- Limits ---
MAX_CAPTURE_CHARS=20000
RATE_LIMIT_PER_MINUTE=60

# --- Async runs ---
RUN_QUEUE=local               # local | cloudtasks
CLOUD_TASKS_QUEUE=
WORKER_URL=http://localhost:8081

# --- Frontend (VITE_ values are PUBLIC, bundled into the browser) ---
VITE_API_BASE_URL=http://localhost:8080
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=demo-ritme
VITE_FIREBASE_APP_ID=
VITE_USE_AUTH_EMULATOR=true
