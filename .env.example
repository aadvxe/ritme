# ==============================================================================
# RITME ENVIRONMENT TEMPLATE (.env.example)
# Copy to .env and fill in your actual project values.
# ==============================================================================

# --- Google Cloud Platform ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-southeast2
VERTEX_LOCATION=us-central1

# --- Frontend & CORS (Vercel) ---
ALLOWED_ORIGINS=https://your-frontend.vercel.app
PUBLIC_WEB_URL=https://your-frontend.vercel.app
EXTENSION_ID=cglnncjoohcjooihmgfhdenaoikilpfg

# --- Cloud SQL (PostgreSQL) ---
SQL_INSTANCE=ritme-db
SQL_TIER=db-f1-micro
DB_NAME=ritme
DB_USER=ritme
# DB_PASSWORD and EXTENSION_TOKEN_SECRET are managed via Secret Manager

# --- Runtime & Logging ---
ROLE=api
ENVIRONMENT=production
LOG_LEVEL=info

# --- AI Engine (Google Vertex AI) ---
LLM_PROVIDER=vertex
LLM_MODEL_FAST=gemini-3.1-flash-lite
LLM_MODEL_PLAN=gemini-3.1-flash-lite
LLM_TIMEOUT_MS=30000
AGENT_MAX_STEPS=8

# --- Authentication (Firebase / Identity Platform) ---
FIREBASE_PROJECT_ID=your-gcp-project-id
EXTENSION_ACCESS_TTL_SECONDS=900

# --- Queue & Limits ---
RUN_QUEUE=local
MAX_CAPTURE_CHARS=20000
RATE_LIMIT_PER_MINUTE=60
