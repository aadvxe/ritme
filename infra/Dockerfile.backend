# Backend-only Dockerfile for Google Cloud Run deployment.
# The frontend is hosted on Vercel, so no Node.js/pnpm build step is required.
# Build command: docker build -f infra/Dockerfile.backend -t ritme-backend .

FROM python:3.12-slim AS app

ENV PYTHONUNBUFFERED=1 \
    UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy

# Install uv for fast, reliable Python package installation
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv

WORKDIR /srv

# Copy Python monorepo dependencies
COPY pyproject.toml uv.lock ./
COPY packages/contracts packages/contracts
COPY packages/ai-engine packages/ai-engine
COPY apps/backend apps/backend

# Install production dependencies for backend
RUN uv sync --frozen --no-dev --package ritme-backend

ENV PATH="/srv/.venv/bin:$PATH" PORT=8080 ROLE=api
WORKDIR /srv/apps/backend

# Default entrypoint supports both ROLE=api and ROLE=worker
CMD ["sh", "-c", "if [ \"$ROLE\" = \"worker\" ]; then exec uvicorn app.worker.main:app --host 0.0.0.0 --port ${PORT}; else exec uvicorn app.main:app --host 0.0.0.0 --port ${PORT}; fi"]
